{
  "__inputs": [
    {
      "name": "DS_VICTORIAMETRICS",
      "label": "VictoriaMetrics",
      "description": "",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "title": "BigQuery",
  "uid": "bigquery-monitoring",
  "tags": ["bigquery", "gcp"],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Bytes scanned per query",
      "type": "timeseries",
      "datasource": "${DS_VICTORIAMETRICS}",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": { "drawStyle": "line", "fillOpacity": 10 }
        }
      },
      "targets": [
        { "expr": "bigquery_googleapis_com_query_statement_scanned_bytes", "legendFormat": "scanned bytes" }
      ]
    },
    {
      "id": 2,
      "title": "Bytes billed per query",
      "type": "timeseries",
      "datasource": "${DS_VICTORIAMETRICS}",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": { "drawStyle": "line", "fillOpacity": 10 }
        }
      },
      "targets": [
        { "expr": "bigquery_googleapis_com_query_statement_scanned_bytes_billed", "legendFormat": "billed bytes" }
      ]
    },
    {
      "id": 3,
      "title": "Jobs in flight",
      "type": "timeseries",
      "datasource": "${DS_VICTORIAMETRICS}",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "bars", "fillOpacity": 30 }
        }
      },
      "targets": [
        { "expr": "bigquery_googleapis_com_job_num_in_flight", "legendFormat": "{{state}} - {{job_type}}" }
      ]
    },
    {
      "id": 4,
      "title": "Queries in flight",
      "type": "timeseries",
      "datasource": "${DS_VICTORIAMETRICS}",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "bars", "fillOpacity": 30 }
        }
      },
      "targets": [
        { "expr": "bigquery_googleapis_com_query_count", "legendFormat": "{{priority}}" }
      ]
    },
    {
      "id": 5,
      "title": "Total bytes scanned",
      "type": "stat",
      "datasource": "${DS_VICTORIAMETRICS}",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 16 },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": { "mode": "fixed", "fixedColor": "text" },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "text", "value": null }]
          }
        }
      },
      "targets": [
        { "expr": "sum(increase(bigquery_googleapis_com_query_statement_scanned_bytes[$__range]))" }
      ]
    },
    {
      "id": 6,
      "title": "Total bytes billed",
      "type": "stat",
      "datasource": "${DS_VICTORIAMETRICS}",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 16 },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": { "mode": "fixed", "fixedColor": "text" },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "text", "value": null }]
          }
        }
      },
      "targets": [
        { "expr": "sum(increase(bigquery_googleapis_com_query_statement_scanned_bytes_billed[$__range]))" }
      ]
    },
    {
      "id": 7,
      "title": "Jobs currently running",
      "type": "stat",
      "datasource": "${DS_VICTORIAMETRICS}",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 16 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }]
          }
        }
      },
      "targets": [
        { "expr": "sum(bigquery_googleapis_com_job_num_in_flight{state=\"RUNNING\"})" }
      ]
    },
    {
      "id": 8,
      "title": "Jobs pending",
      "type": "stat",
      "datasource": "${DS_VICTORIAMETRICS}",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 16 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 1 }]
          }
        }
      },
      "targets": [
        { "expr": "sum(bigquery_googleapis_com_job_num_in_flight{state=\"PENDING\"})" }
      ]
    }
  ]
}